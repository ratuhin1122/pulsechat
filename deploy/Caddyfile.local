{
	metrics
	auto_https off
	log default {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete access_token
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

http://localhost {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete access_token
				}
			}
		}
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' ws://localhost:8080; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
	encode zstd gzip
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}
	@api path /auth /auth/* /rooms /rooms/* /users /files /files/* /presence /ws /healthz /readyz
	handle @api {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Dedicated metrics listener; the admin API remains private to the container.
http://:9180 {
	metrics /metrics
	respond 404
}
