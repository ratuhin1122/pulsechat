    {
      "id": 6,
      "title": "Messages/sec by type and API instance",
      "description": "Counts live hub events, not persisted messages. Redis fan-out produces one copy per receiving API; do not sum instances as a global creation rate. History replay is excluded.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
