          },
          "expr": "redis_memory_used_bytes{job=\"redis-exporter\"}",
          "legendFormat": "used · {{instance}}",
          "editorMode": "code",
          "format": "time_series",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
