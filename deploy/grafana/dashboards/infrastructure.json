{
  "id": null,
  "uid": "pulsechat-infrastructure",
  "title": "Infrastructure",
  "description": "Database, Redis and optional container resource/slow-query metrics.",
  "tags": [
    "pulsechat",
    "provisioned"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Pulsechat dashboards",
      "tags": [
        "pulsechat"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Metric availability",
      "description": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Postgres connections and Redis panels use the provisioned exporters. **Slow-query details require** `pg_stat_statements` in PostgreSQL and the optional postgres-exporter `stat_statements` collector. **Container CPU/memory require** a cAdvisor-compatible scrape job named `cadvisor`. These collectors are not installed by this dashboard change; their panels intentionally show **No data**, not a false zero. Longest active transaction is shown separately and is not an individual query duration."
      }
    },
    {
      "id": 2,
      "title": "Postgres connections by database",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (pg_stat_database_numbackends{job=\"postgres-exporter\",datname!=\"\"})",
          "legendFormat": "{{datname}}",
          "editorMode": "code",
          "format": "time_series",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Postgres longest active transaction",
      "description": "Duration since transaction start, which may span several queries; not an exact slow-query measurement.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (datname) (pg_stat_activity_max_tx_duration{job=\"postgres-exporter\",state=\"active\",datname!=\"\"})",
          "legendFormat": "{{datname}}",
          "editorMode": "code",
          "format": "time_series",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Slow queries: top 10 with mean execution ≥ 1s",
      "description": "Requires pg_stat_statements and exporter --collector.stat_statements. Mean execution duration per statement fingerprint, not a p95 or a count of individually slow executions. Query text is not collected or displayed.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, (sum by (datname,queryid) (rate(pg_stat_statements_seconds_total{job=\"postgres-exporter\"}[$__rate_interval])) / sum by (datname,queryid) (rate(pg_stat_statements_calls_total{job=\"postgres-exporter\"}[$__rate_interval]))) >= 1)",
          "legendFormat": "{{datname}} · query {{queryid}}",
          "editorMode": "code",
          "format": "time_series",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Redis memory used",
      "description": "A maxmemory value of zero means no configured Redis memory limit.",
      "type": "timeseries",
      "datasource": {
