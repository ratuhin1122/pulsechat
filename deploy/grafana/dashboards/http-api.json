      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * ((sum by (route) (rate(http_request_duration_seconds_count{job=\"api\",instance=~\"$api_instance\",route=~\"$route\",route!=\"GET /ws\",status=~\"5..\"}[$__rate_interval])) or on (route) (0 * sum by (route) (rate(http_request_duration_seconds_count{job=\"api\",instance=~\"$api_instance\",route=~\"$route\",route!=\"GET /ws\"}[$__rate_interval])))) / clamp_min(sum by (route) (rate(http_request_duration_seconds_count{job=\"api\",instance=~\"$api_instance\",route=~\"$route\",route!=\"GET /ws\"}[$__rate_interval])), 1e-9))",
          "legendFormat": "5xx · {{route}}",
