{
  "id": null,
  "uid": "pulsechat-http-api",
  "title": "HTTP and API",
  "description": "Completed HTTP requests by registered ServeMux pattern. Excludes GET /ws so WebSocket lifetimes do not distort API latency.",
  "tags": [
    "pulsechat",
    "provisioned"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "api_instance",
        "label": "API instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"api\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"api\"}, instance)",
          "refId": "variable-api_instance"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "route",
        "label": "Route pattern",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(http_request_duration_seconds_count{job=\"api\"}, route)",
        "query": {
          "query": "label_values(http_request_duration_seconds_count{job=\"api\"}, route)",
          "refId": "variable-route"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Pulsechat dashboards",
      "tags": [
        "pulsechat"
      ],
      "asDropdown": true,
      "includeVars": false,
